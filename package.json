  "description": "A Tampermonkey script designed to replace images identified as sexually explicit on FetLife.com with delightful pictures of tiny technicolor elephants.",
  "main": "fetlife-technicolor-elephants.user.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .js",
    "docs": "jsdoc -c jsdoc.config.js",
    "test:integration": "jest --testPathPattern=integration.test.js",
    "prepare": "husky install"
  },
  "keywords": [
